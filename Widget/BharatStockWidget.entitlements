<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mandatory for a widget extension. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The only path this extension may read or write. config.json, quotes.json, budget.json
	     and refresh-state.json all live here. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(BSW_APP_GROUP)</string>
	</array>

	<!-- The widget performs its own fetches; there is no helper process. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
