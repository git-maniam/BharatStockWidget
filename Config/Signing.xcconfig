// Signing configuration for BharatStock Widget.
//
// Set DEVELOPMENT_TEAM to your 10-character Apple Developer Team ID. A free Apple ID is enough:
// sign in under Xcode ▸ Settings ▸ Accounts, and the Team ID appears beside your Personal Team
// (you can also read it from `security find-identity -v -p codesigning`, inside the parentheses
// of "Apple Development: you@example.com (ABCDE12345)").
//
// Why it matters: macOS requires the App Group identifier to be Team-ID-prefixed, and the App
// Group is the only channel between the widget extension and the container app. With this unset
// the project still compiles, but the installed widget will not find the cache the app writes.
//
// `make build` and `make test` work without it. `make install` needs it.

DEVELOPMENT_TEAM =

// Default to CODE_SIGNING_ALLOWED = NO so Xcode and command-line builds compile immediately
// without requiring an Apple Developer certificate.
// When you set DEVELOPMENT_TEAM, set CODE_SIGNING_ALLOWED = YES.
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_STYLE = Automatic

// App Group identifier:
// Defaults to the un-prefixed group name for local development.
// If signing with a Team ID, prefix with $(DEVELOPMENT_TEAM).
// e.g.: BSW_APP_GROUP = $(DEVELOPMENT_TEAM).group.com.ravisubramaniam.bharatstockwidget
BSW_APP_GROUP = group.com.ravisubramaniam.bharatstockwidget

